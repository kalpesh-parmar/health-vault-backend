APP_NAME=Health Vault
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/health_vault
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=health-vault
JWT_AUDIENCE=

MAX_LOGIN_ATTEMPTS=3
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_WINDOW_MINUTES=15

EMAIL_ENABLED=false
EMAIL_FROM=no-reply@health-vault.local
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Storage selection is configuration-driven. Use STORAGE_PROVIDER=auto to pick
# GCP when GCP credentials are present, otherwise S3 when AWS credentials are present.
STORAGE_PROVIDER=auto
PATIENT_DOCUMENTS_BUCKET=patient-documents
USER_PROFILE_IMAGES_BUCKET=user-profile-images
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=patient-documents
GCP_CREDENTIALS_BASE64=

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Single AI/OCR model configuration shared by the Node API and Python ai-service.
# Set AI_BASE_URL to a supported model API endpoint. Google AI endpoints use
# the Google GenAI SDK; other endpoints are treated as chat-completions compatible.
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
# Optional for local endpoints; required for hosted endpoints that enforce API keys.
AI_API_KEY=
AI_TIMEOUT_MS=90000
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_PAGE_CONCURRENCY=4
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INLINE_BYTES=18874368
AI_MIN_TEXT_CHARS=8
AI_MIN_CONFIDENCE=0.35
AI_CACHE_SIZE=64

AI_SERVICE_URL=http://127.0.0.1:8000
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHAT_CONCURRENCY=4
VOICE_CONCURRENCY=2
WHISPER_MODEL=small
TTS_MODEL_NAME=tts_models/en/ljspeech/tacotron2-DDC
VOICE_REALTIME_ENABLED=true
MAX_PDF_PAGES=25
SUMMARY_FROM_VISION=true
OCR_SLIM_RESPONSE=false
OCR_FAIL_ON_EMPTY=true
SUMMARY_CHUNK_CHARS=1800
SUMMARY_MAX_CHUNKS=8
SUMMARY_NUM_PREDICT=220
RAG_TOP_K=8
