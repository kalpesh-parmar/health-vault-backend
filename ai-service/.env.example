# ==========================================
# Health Vault Unified AI Service Configuration
# ==========================================

# ── General Configuration ──────────────────
# App Name (displayed in docs)
APP_NAME="Health Vault Unified AI Service"
# Environment mode: development, staging, production
NODE_ENV=development
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Database (PostgreSQL with pgvector) ──────
# Connection URL. Must be an async-compatible postgresql+asyncpg driver URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/health_vault

# ── Storage Configuration (AWS S3 or GCP) ──
# Storage provider. Choices: s3, gcp, auto
STORAGE_PROVIDER=s3
# Name of the bucket containing patient documents
PATIENT_DOCUMENTS_BUCKET=patient-documents

# AWS S3 Settings (Required if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Google Cloud Storage Settings (Required if STORAGE_PROVIDER=gcp)
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=your-gcp-bucket-name
# Base64 encoded Service Account credentials JSON string
GCP_CREDENTIALS_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogIi4uLiJ9

# ── AI Model Gateway (Ollama / Gemini / OpenAI / Anthropic) ────
# Model identifier (e.g., qwen3-vl:latest, gemini-1.5-flash, claude-3-sonnet-20240229)
AI_MODEL=qwen3-vl:latest
# Gateway Endpoint (e.g., http://localhost:11434/v1 for local Ollama, https://api.openai.com/v1)
AI_BASE_URL=http://122.174.67.117:11434/v1
# API Key (Omitted/blank for local Ollama; required for Google/Anthropic/OpenAI)
AI_API_KEY=

# ── AI Parameter Tuning ──────────────────
AI_TIMEOUT_SECONDS=90.0
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192
# Concurrent page processing speed for scanned PDFs
AI_PAGE_CONCURRENCY=4
AI_MAX_INLINE_BYTES=18874368
AI_MIN_TEXT_CHARS=8
AI_MIN_CONFIDENCE=0.35
AI_CACHE_SIZE=64

# ── OCR & Embeddings ─────────────────────
SUMMARY_FROM_VISION=true
OCR_SLIM_RESPONSE=false
OCR_FAIL_ON_EMPTY=true
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=8

# ── Voice Processing (Whisper & TTS) ──────
WHISPER_MODEL=small
TTS_MODEL_NAME=tts_models/en/ljspeech/tacotron2-DDC
VOICE_REALTIME_ENABLED=true
VOICE_CONCURRENCY=2

# ── Security & CORS Configuration ─────────
# Comma-separated list of allowed origins. Use * to allow all origins.
CORS_ORIGINS=*

# Hugging Face access token with read permission for the gated
# ai4bharat/indictrans2-en-indic-dist-200M repository
HF_TOKEN=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

