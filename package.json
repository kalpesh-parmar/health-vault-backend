{
  "name": "health-vault",
  "version": "1.0.0",
  "description": "Health Vault backend API",
  "homepage": "https://github.com/tulsihirpara011/health-vault#readme",
  "bugs": {
    "url": "https://github.com/tulsihirpara011/health-vault/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tulsihirpara011/health-vault.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "nodemon src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "node src/server.js",
    "test": "npm run lint && npm run test:ocr",
    "test:unit": "npx jest",
    "test:ocr": "npx jest tests/services/aiService/ocr",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "analyze:project": "mkdir reports && depcruise . --exclude '^node_modules' --output-type html > reports/architecture.html && madge . --extensions js,ts --image reports/dependency-graph.svg"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^2.7.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^13.8.0",
    "form-data": "^4.0.5",
    "generate": "^0.14.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "migrate": "^2.1.0",
    "moment-timezone": "^0.6.2",
    "multer": "^2.1.1",
    "mustache": "^4.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@redocly/cli": "^2.31.5",
    "@types/pg": "^8.20.0",
    "dependency-cruiser": "^17.4.3",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
